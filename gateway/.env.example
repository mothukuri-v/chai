PORT=4000
NODE_ENV=development

MONGO_URI=mongodb://mongo:27017/chaipass

JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Internal service-to-service token used to call Spring Boot
SERVICE_JWT_SECRET=replace-with-strong-secret
BUSINESS_SERVICE_URL=http://business-service:8080/internal

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

CORS_ORIGIN=http://localhost:5173
