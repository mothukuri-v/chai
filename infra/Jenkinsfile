pipeline {
    agent any

    tools {
        maven 'maven-3.9'
        nodejs 'node-20'
    }

    environment {
        ECR_REGISTRY   = "123456789012.dkr.ecr.ap-south-1.amazonaws.com"
        SONAR_HOST_URL = credentials('sonarqube-url')
        AWS_REGION     = "ap-south-1"
        IMAGE_TAG      = "${env.GIT_COMMIT.take(7)}"
    }

    stages {

        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Build & Test') {
            parallel {
                stage('Frontend') {
                    steps {
                        dir('frontend') {
                            sh 'npm ci'
                            sh 'npm run lint'
                            sh 'npm run build'
                        }
                    }
                }
                stage('Gateway') {
                    steps {
                        dir('gateway') {
                            sh 'npm ci'
                            sh 'npm run lint'
                            sh 'npm test -- --ci'
                        }
                    }
                }
                stage('Business Service') {
                    steps {
                        dir('business-service') {
                            sh 'mvn -B clean verify'
                        }
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube-server') {
                    dir('business-service') {
                        sh 'mvn -B sonar:sonar -Dsonar.projectKey=chaipass-business-service'
                    }
                    dir('gateway') {
                        sh 'npx sonar-scanner -Dsonar.projectKey=chaipass-gateway -Dsonar.sources=.'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    ['frontend', 'gateway', 'business-service'].each { svc ->
                        sh """
                          docker build -t ${ECR_REGISTRY}/chaipass-${svc}:${IMAGE_TAG} ${svc}
                          aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                          docker push ${ECR_REGISTRY}/chaipass-${svc}:${IMAGE_TAG}
                        """
                    }
                }
            }
        }

        stage('Deploy to ECS') {
            when { branch 'main' }
            steps {
                script {
                    ['frontend', 'gateway', 'business-service'].each { svc ->
                        sh "aws ecs update-service --cluster chaipass-prod --service chaipass-${svc} --force-new-deployment --region ${AWS_REGION}"
                    }
                }
            }
        }
    }

    post {
        always { junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml, **/junit.xml' }
        failure { echo 'Pipeline failed — check Sonar quality gate and test reports above.' }
    }
}
